<?php

namespace Statamic\Auth;

/**
 * The abstract base of Statamic's two user classes (`File\User`,
 * `Eloquent\User`) does not declare the accessors both of them implement.
 * Every user the repositories hand out is one of the two, so the methods are
 * there at runtime; this stub says so for the analyser instead of silencing
 * each call.
 *
 * @method mixed id(mixed $id = null)
 * @method mixed email(mixed $email = null)
 * @method mixed password(mixed $password = null)
 * @method \Illuminate\Support\Collection<int|string, mixed> roles()
 * @method mixed groups(mixed $groups = null)
 * @method \DateTimeInterface|null lastLogin()
 * @method string|null avatar(int $size = 64)
 */
abstract class User {}

namespace Statamic\Contracts\Query;

/**
 * The query builder contract Statamic's facades return is empty; every
 * implementation extends `Statamic\Query\Builder`.
 *
 * @method static orderBy(string $column, string $direction = 'asc')
 * @method static limit(int $value)
 * @method int count()
 * @method \Illuminate\Support\Collection<int|string, mixed> get(array<int, string> $columns = ['*'])
 */
interface Builder {}
