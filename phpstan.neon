includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Registers the addon's view namespace, see the file.
    bootstrapFiles:
        - phpstan-bootstrap.php

    level: 5

    # A project-local cache. PHPStan's default temp directory is shared across
    # every project on the machine.
    tmpDir: .phpstan

    paths:
        - src
        - config
        - routes

    treatPhpDocTypesAsCertain: false

    # Corrects a wrong annotation in Statamic itself, see the stub for why.
    stubFiles:
        - phpstan/AddonServiceProvider.stub
        - phpstan/StatamicUser.stub

    # email-templates is a `suggest`: the default template source implements
    # its contract. Scanned from the test stand-in so it is checked against
    # the real signature instead of reported as unknown.
    scanFiles:
        - tests/Fakes/email-templates-contracts.php
